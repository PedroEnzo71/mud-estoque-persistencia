@page "/categorias"
@using MudEstoquePersistenciaDados.Models
@using MudEstoquePersistenciaDados.Services.Interfaces
@inject ICategoriaService CategoriaService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@rendermode InteractiveServer

<PageTitle>Categorias | MudEstoque</PageTitle>

<MudBreadcrumbs Items="_breadcrumbItems" Separator="/" Class="pa-0 mb-3" />

<div class="d-flex flex-column flex-sm-row justify-space-between align-start align-sm-center gap-3 mb-4">
    <div>
        <div class="d-flex align-center gap-2">
            <MudText Typo="Typo.h5" Class="fw-bold">Categorias</MudText>
            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" Class="font-monospace">
                @_categoriasFiltradas.Count() @(_categoriasFiltradas.Count() == 1 ? "registro" : "registros")
            </MudChip>
        </div>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Organize os grupos e famílias de produtos do seu catálogo de estoque.
        </MudText>
    </div>
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="NovaAsync"
               Size="Size.Small"
               Class="px-3 py-1">
        Nova categoria
    </MudButton>
</div>

<MudPaper Elevation="0" Outlined="true" Class="pa-3 mb-4">
    <div class="d-flex flex-column flex-sm-row justify-space-between align-stretch align-sm-center gap-2 mb-3">
        <MudTextField @bind-Value="_busca"
                      Placeholder="Buscar por nome ou descrição..."
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      IconSize="Size.Small"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Clearable="true"
                      Immediate="true"
                      Class="flex-grow-1"
                      Style="max-width: 400px;" />

        <MudButton Variant="Variant.Outlined"
                   Color="Color.Default"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="CarregarAsync"
                   Disabled="_carregando"
                   Size="Size.Small">
            Atualizar
        </MudButton>
    </div>

    <MudDataGrid T="Categoria"
                 Items="_categoriasFiltradas"
                 Loading="_carregando"
                 Hover="true"
                 Dense="true"
                 Striped="true">
        <Columns>
            <PropertyColumn Property="c => c.Nome" Title="Nome" Sortable="true" HeaderClass="fw-bold" />
            <PropertyColumn Property="c => c.Descricao" Title="Descrição" Sortable="false">
                <CellTemplate>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        @(string.IsNullOrWhiteSpace(context.Item.Descricao) ? "—" : context.Item.Descricao)
                    </MudText>
                </CellTemplate>
            </PropertyColumn>
            <TemplateColumn Title="Situação" Sortable="true" HeaderClass="fw-bold" HeaderStyle="width: 120px;">
                <CellTemplate>
                    @if (context.Item.Ativo)
                    {
                        <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled">Ativa</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Color="Color.Default" Size="Size.Small" Variant="Variant.Outlined">Inativa</MudChip>
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Ações" Sortable="false" HeaderStyle="width: 100px;" CellClass="d-flex justify-end gap-1">
                <CellTemplate>
                    <MudTooltip Text="Editar categoria">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Size="Size.Small"
                                       Color="Color.Default"
                                       OnClick="() => EditarAsync(context.Item)" />
                    </MudTooltip>
                    <MudTooltip Text="Excluir categoria">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Size="Size.Small"
                                       Color="Color.Error"
                                       OnClick="() => ExcluirAsync(context.Item)" />
                    </MudTooltip>
                </CellTemplate>
            </TemplateColumn>
        </Columns>

        <NoRecordsContent>
            <div class="d-flex flex-column align-center justify-center py-8">
                <MudIcon Icon="@Icons.Material.Outlined.Category" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
                <MudText Typo="Typo.subtitle1" Color="Color.Secondary" Class="fw-semibold">
                    @(string.IsNullOrWhiteSpace(_busca) ? "Nenhuma categoria cadastrada" : "Nenhum resultado para a busca")
                </MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @(string.IsNullOrWhiteSpace(_busca) ? "Clique em 'Nova categoria' para iniciar o catálogo." : "Tente buscar com outros termos.")
                </MudText>
            </div>
        </NoRecordsContent>

        <PagerContent>
            <MudDataGridPager T="Categoria"
                              RowsPerPageString="Linhas por página:"
                              InfoFormat="{first_item}-{last_item} de {all_items}" />
        </PagerContent>
    </MudDataGrid>
</MudPaper>

@code {
    private List<Categoria> _categorias = [];
    private string? _busca;
    private bool _carregando;

    private readonly List<BreadcrumbItem> _breadcrumbItems =
    [
        new("Início", href: "/"),
        new("Cadastros", href: null, disabled: true),
        new("Categorias", href: "/categorias", disabled: false)
    ];

    private IEnumerable<Categoria> _categoriasFiltradas =>
        string.IsNullOrWhiteSpace(_busca)
            ? _categorias
            : _categorias.Where(c =>
                c.Nome.Contains(_busca, StringComparison.OrdinalIgnoreCase) ||
                (c.Descricao is not null && c.Descricao.Contains(_busca, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync()
    {
        await CarregarAsync();
    }

    private async Task CarregarAsync()
    {
        _carregando = true;
        try
        {
            IEnumerable<Categoria> categorias = await CategoriaService.ListarTodosAsync();
            _categorias = categorias.ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao carregar as categorias: {ex.Message}", Severity.Error);
        }
        finally
        {
            _carregando = false;
        }
    }

    private async Task NovaAsync()
    {
        await AbrirDialogoAsync(0, "Nova categoria");
    }

    private async Task EditarAsync(Categoria categoria)
    {
        await AbrirDialogoAsync(categoria.Id, "Editar categoria");
    }

    private async Task AbrirDialogoAsync(int id, string titulo)
    {
        DialogParameters<CategoriaDialog> parametros = new()
        {
            { d => d.Id, id }
        };

        DialogOptions opcoes = new()
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            CloseButton = true
        };

        IDialogReference dialogo = await DialogService.ShowAsync<CategoriaDialog>(titulo, parametros, opcoes);
        DialogResult? resultado = await dialogo.Result;

        if (resultado is not null && !resultado.Canceled)
        {
            await CarregarAsync();
        }
    }

    private async Task ExcluirAsync(Categoria categoria)
    {
        bool? confirmou = await DialogService.ShowMessageBox(
            "Excluir categoria",
            $"Deseja realmente excluir a categoria \"{categoria.Nome}\"?",
            yesText: "Excluir",
            cancelText: "Cancelar");

        if (confirmou != true)
        {
            return;
        }

        try
        {
            bool excluiu = await CategoriaService.ExcluirAsync(categoria.Id);
            if (excluiu)
            {
                Snackbar.Add("Categoria excluída com sucesso.", Severity.Success);
            }
            else
            {
                Snackbar.Add("Esta categoria não foi encontrada no banco.", Severity.Warning);
            }

            await CarregarAsync();
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro inesperado: {ex.Message}", Severity.Error);
        }
    }
}
