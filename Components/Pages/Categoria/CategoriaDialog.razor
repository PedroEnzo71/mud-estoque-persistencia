@using MudEstoquePersistenciaDados.Services.Interfaces
@using MudEstoquePersistenciaDados.ViewModels
@using MudEstoquePersistenciaDados.Models
@inject ICategoriaService CategoriaService
@inject ISnackbar Snackbar

<EditForm EditContext="_editContext" OnValidSubmit="SalvarAsync">
    <DataAnnotationsValidator />

    <MudDialog>
        <TitleContent>
            <div class="d-flex align-center gap-2">
                <MudIcon Icon="@(_viewModel.EmEdicao ? Icons.Material.Filled.Edit : Icons.Material.Filled.AddCircle)"
                         Color="Color.Primary"
                         Size="Size.Small" />
                <MudText Typo="Typo.subtitle1" Class="fw-bold">
                    @(_viewModel.EmEdicao ? "Editar Categoria" : "Nova Categoria")
                </MudText>
            </div>
        </TitleContent>

        <DialogContent>
            @if (_carregando)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-3" />
            }
            else
            {
                <MudTextField Label="Nome da Categoria"
                              @bind-Value="_viewModel.Nome"
                              For="@(() => _viewModel.Nome)"
                              MaxLength="100"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="mb-3"
                              Immediate="true"
                              Disabled="_salvando" />

                <MudTextField Label="Descrição detalhada"
                              @bind-Value="_viewModel.Descricao"
                              For="@(() => _viewModel.Descricao)"
                              Lines="3"
                              MaxLength="500"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="mb-3"
                              Disabled="_salvando" />

                <MudCheckBox @bind-Value="_viewModel.Ativo"
                             Label="Ativa para novos produtos"
                             Color="Color.Primary"
                             Dense="true"
                             Size="Size.Small"
                             Disabled="_salvando" />
            }
        </DialogContent>

        <DialogActions>
            <MudButton OnClick="Cancelar"
                       Variant="Variant.Text"
                       Color="Color.Default"
                       Size="Size.Small"
                       Disabled="_salvando">
                Cancelar
            </MudButton>
            <MudButton ButtonType="ButtonType.Submit"
                       Color="Color.Primary"
                       Variant="Variant.Filled"
                       Size="Size.Small"
                       Disabled="_salvando || _carregando">
                @if (_salvando)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                    <span class="ms-2">Salvando...</span>
                }
                else
                {
                    <span>Salvar</span>
                }
            </MudButton>
        </DialogActions>
    </MudDialog>
</EditForm>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public int Id { get; set; }

    private CategoriaViewModel _viewModel = new();
    private EditContext _editContext = default!;
    private bool _carregando;
    private bool _salvando;

    protected override void OnInitialized()
    {
        _editContext = new EditContext(_viewModel);
    }

    protected override async Task OnInitializedAsync()
    {
        if (Id != 0)
        {
            _carregando = true;
            try
            {
                Categoria? categoria = await CategoriaService.ObterPorIdAsync(Id);
                if (categoria == null)
                {
                    Snackbar.Add("Esta categoria não foi encontrada no banco.", Severity.Warning);
                    MudDialog.Cancel();
                    return;
                }

                _viewModel = CategoriaViewModel.DaEntidade(categoria);
                _editContext = new EditContext(_viewModel);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Erro ao carregar os dados: {ex.Message}", Severity.Error);
                MudDialog.Cancel();
            }
            finally
            {
                _carregando = false;
            }
        }
    }

    private async Task SalvarAsync()
    {
        if (_salvando)
        {
            return;
        }

        _salvando = true;
        try
        {
            Categoria categoria = _viewModel.ParaEntidade();

            if (_viewModel.EmEdicao)
            {
                bool alterou = await CategoriaService.AlterarAsync(categoria);
                if (!alterou)
                {
                    Snackbar.Add("Esta categoria não existe mais.", Severity.Warning);
                    MudDialog.Cancel();
                    return;
                }

                Snackbar.Add("Categoria atualizada com sucesso!", Severity.Success);
            }
            else
            {
                await CategoriaService.AdicionarAsync(categoria);
                Snackbar.Add("Categoria cadastrada com sucesso!", Severity.Success);
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao salvar: {ex.Message}", Severity.Error);
        }
        finally
        {
            _salvando = false;
        }
    }

    private void Cancelar() => MudDialog.Cancel();
}
